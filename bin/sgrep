#!/usr/bin/env sh
# Runs the sgrep build for this platform. sgrep execs sgrep-sem from its own directory, so exec the real path.
d="$(cd "$(dirname "$0")/.." && pwd)/sgrep"
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in aarch64|arm64) arch=arm64 ;; x86_64|amd64) arch=x86_64 ;; *) arch=$(uname -m) ;; esac
bin="$d/$os-$arch/sgrep"
[ -x "$bin" ] || { echo "sgrep: no build for $os-$arch in $d (build it, see sgrep/README.md)" >&2; exit 127; }
: "${SGREP_MODEL_DIR:=$(dirname "$d")/models/granite-97m}"
export SGREP_MODEL_DIR
exec "$bin" "$@"
